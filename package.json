    "@react-aria/ssr": "3.10.1",
    "@react-aria/utils": "3.34.1",
    "@sanity/client": "8.7.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "formik": "^2.4.9",
    "framer-motion": "^13.4.4",
    "jose": "^6.2.12",
