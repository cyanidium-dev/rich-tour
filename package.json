{
  "name": "reach-tour",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "users:migrate:plan": "node --env-file=.env.local scripts/migrate-users-dataset.mjs",
    "users:migrate:plan-with-resets": "node --env-file=.env.local scripts/migrate-users-dataset.mjs --reset-missing-plain",
