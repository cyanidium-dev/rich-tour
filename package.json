{
  "name": "reach-tour",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mts\" \"*.{ts,mts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mts\" \"*.{ts,mts,mjs}\"",
    "typecheck": "tsc --noEmit && npm run typecheck:scripts",
    "test": "vitest run",
    "check:architecture": "node scripts/check-architecture.mts",
    "users:migrate:plan": "node --env-file=.env.local scripts/migrate-users-dataset.mts",
    "users:migrate:plan-with-resets": "node --env-file=.env.local scripts/migrate-users-dataset.mts --reset-missing-plain",
    "users:migrate:apply": "node --env-file=.env.local scripts/migrate-users-dataset.mts --reset-missing-plain --apply --confirm-copy-users --confirm-reset-missing-passwords",
    "users:cleanup:plan": "node --env-file=.env.local scripts/cleanup-source-users.mts",
    "users:cleanup:apply": "node --env-file=.env.local scripts/cleanup-source-users.mts --apply --confirm-delete-source-users",
    "users:audit": "node --env-file=.env.local scripts/audit-users-dataset.mts",
    "users:display:plan": "node --env-file=.env.local scripts/backfill-user-display.mts",
    "users:display:apply": "node --env-file=.env.local scripts/backfill-user-display.mts --apply --confirm-public-labels",
    "users:agent-profile:plan": "node --env-file=.env.local scripts/backfill-agent-open-profile.mts",
    "users:agent-profile:apply": "node --env-file=.env.local scripts/backfill-agent-open-profile.mts --apply --confirm-public-agent-profile",
    "users:crypto:test": "node scripts/test-user-crypto-compat.mts",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json",
    "test:calendar": "node scripts/test-calendar-dates.mts"
  },
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@hookform/resolvers": "5.9.1",
    "@internationalized/date": "3.12.4",
    "@portabletext/react": "8.0.1",
    "@react-aria/i18n": "3.13.1",
    "@react-aria/ssr": "3.10.1",
    "@react-aria/utils": "3.34.1",
    "@sanity/client": "8.7.0",
    "@sanity/webhook": "^4.0.4",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^13.4.4",
    "jose": "^6.2.12",
    "lottie-react": "^3.1.2",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-imask": "7.6.1",
    "swiper": "^14.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@react-types/shared": "^3.36.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.6",
    "jsdom": "30.1.1",
    "postcss": "^8.5.28",
    "prettier": "3.6.2",
    "tailwind-scrollbar": "4.0.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.3.1",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
