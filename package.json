    "users:cleanup:plan": "node --env-file=.env.local scripts/cleanup-source-users.mjs",
    "users:cleanup:apply": "node --env-file=.env.local scripts/cleanup-source-users.mjs --apply --confirm-delete-source-users",
    "users:audit": "node --env-file=.env.local scripts/audit-users-dataset.mjs",
    "users:crypto:test": "node scripts/test-user-crypto-compat.mjs"
  },
  "dependencies": {
